# Server-only. Never prefix these with NEXT_PUBLIC_.

# Django API base URL, with the version prefix. Only the Next server calls it.
API_URL=http://127.0.0.1:8000/api/v1

# The same random value as the API's VISITOR_IP_SECRET, so sign-ins are
# rate-limited per visitor. Optional locally; in production the server
# answers nothing without it (instrumentation.ts).
VISITOR_IP_SECRET=

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
